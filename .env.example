# Copy of the variables scripts/init-env.sh generates. Do not put real values
# here; run `scripts/init-env.sh` to create .env with random local secrets.
PRODUCT_NAME="Common Ground"
COUNTY_NAME="Westwind County"
HELP_PHONE="(314) 555-0142"
GATEWAY_HOST=localhost
# Optional profiles: maps (self-hosted geocoder; imports Missouri on first start)
COMPOSE_PROFILES=

POSTGRES_PASSWORD=change-me
CG_MIGRATOR_PASSWORD=change-me
CG_APP_PASSWORD=change-me
CG_WORKER_PASSWORD=change-me
KEYCLOAK_DB_PASSWORD=change-me
KEYCLOAK_ADMIN_PASSWORD=change-me
RABBITMQ_PASSWORD=change-me
MINIO_ROOT_PASSWORD=change-me
CJIS_POSTGRES_PASSWORD=change-me
CJIS_APP_PASSWORD=change-me
RESIDENT_TOKEN_SECRET=change-me-32-characters-minimum-local-only

# Optional: real texting and calls through Twilio (docs/06). Leave empty for the simulator.
# Webhooks reach a laptop only through a secured development tunnel (CLAUDE.md rule 3).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WEBHOOK_PUBLIC_BASE=

# Abuse protection (SEC-17): public submissions from one address per ten minutes before a
# verification flag and before a retryable 429. Raise the deny limit only on a stack that a
# load generator on one host is testing (tests/load/README.md).
PUBLIC_IP_VERIFY_PER_10MIN=20
PUBLIC_IP_DENY_PER_10MIN=120
