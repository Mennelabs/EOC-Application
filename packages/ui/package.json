{
  "name": "@cg/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared design foundation: tokens, fonts, base styles and accessible components for every web app (ADR-0045)",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/index.css",
    "./tokens.css": "./src/styles/tokens.css",
    "./fonts/staff.css": "./src/styles/fonts-staff.css",
    "./fonts/public.css": "./src/styles/fonts-public.css",
    "./theme": "./src/theme.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "showcase": "vite --config showcase.vite.config.ts",
    "build:showcase": "vite build --config showcase.vite.config.ts",
    "test:showcase": "playwright test --config playwright.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "lucide-react": "1.52.0",
    "react-aria-components": "1.21.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.1"
  }
}
